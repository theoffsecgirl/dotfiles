# Ghostty config — Ari

font-family = JetBrainsMono Nerd Font
font-size = 17

macos-option-as-alt = true

# Comodidad visual
window-padding-x = 12
window-padding-y = 10

# Cursor
cursor-style = block
cursor-style-blink = false

# Selección
copy-on-select = true

# Tema: Neon Fuchsia (themes/neon-fuchsia)
theme = neon-fuchsia

# Toque cyber: fondo ligeramente translúcido con desenfoque
background-opacity = 0.94
background-blur = 20
unfocused-split-opacity = 0.85
window-theme = dark
macos-titlebar-style = tabs
