// fastfetch — theoffsecgirl
// Minimal: sin logo ni frases, solo la información.
// Los colores usan nombres ANSI; el comando `theme` los cambia por los del tema
// (magenta = principal, bright_magenta = secundario, cyan = acento, white = texto,
//  bright_black = gris tenue).
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "type": "none" },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "magenta",
      "title": "bright_magenta",
      "output": "white",
      "separator": "bright_black"
    },
    "key": { "width": 10 }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "format": "{#magenta}{user-name}{#bright_black}@{#bright_magenta}{host-name}"
    },
    {
      "type": "custom",
      "format": "{#bright_black}────────────────────────────────────"
    },
    { "type": "os",       "key": "os" },
    { "type": "kernel",   "key": "kernel" },
    { "type": "uptime",   "key": "uptime" },
    { "type": "shell",    "key": "shell" },
    { "type": "terminal", "key": "term" },
    { "type": "cpu",      "key": "cpu" },
    { "type": "memory",   "key": "ram" },
    { "type": "disk",     "key": "disk", "folders": "/" },
    { "type": "battery",  "key": "batt" },
    "break"
  ]
}
