// fastfetch — Neon Fuchsia · theoffsecgirl
// Los colores usan nombres ANSI, así heredan exactamente la paleta de Ghostty
// (magenta = fucsia #ff2bd6, bright_magenta = rosa #ff7ae6, cyan = #00e5ff).
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo.txt",
    "color": {
      "1": "magenta",
      "2": "bright_magenta",
      "3": "cyan"
    },
    "padding": { "top": 1, "left": 1, "right": 4 }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "magenta",
      "title": "bright_magenta",
      "output": "white"
    },
    "key": { "width": 16 }
  },
  "modules": [
    {
      "type": "custom",
      "format": "{#cyan}▓▒░ {#bright_magenta}SYSTEM ONLINE {#cyan}░▒▓{#}  {#magenta}// access granted"
    },
    {
      "type": "title",
      "format": "{#magenta}{user-name}{#cyan}@{#bright_magenta}{host-name}"
    },
    {
      "type": "custom",
      "format": "{#magenta}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    },
    { "type": "os",       "key": "╭─ 󰀵 os" },
    { "type": "host",     "key": "├─ 󰌢 host" },
    { "type": "kernel",   "key": "├─  kernel" },
    { "type": "uptime",   "key": "├─ 󰅐 uptime" },
    { "type": "packages", "key": "├─ 󰏖 pkgs" },
    { "type": "shell",    "key": "├─  shell" },
    { "type": "terminal", "key": "╰─  term" },
    "break",
    { "type": "cpu",      "key": "╭─ 󰻠 cpu" },
    { "type": "gpu",      "key": "├─ 󰍛 gpu" },
    { "type": "memory",   "key": "├─  ram" },
    { "type": "disk",     "key": "├─ 󰋊 disk", "folders": "/" },
    { "type": "localip",  "key": "├─ 󰩟 ip" },
    { "type": "battery",  "key": "╰─ 󰁹 batt" },
    "break",
    {
      "type": "custom",
      "format": "{#magenta}[ {#cyan}bug hunter {#magenta}· {#cyan}instructor {#magenta}· {#cyan}hack the planet {#magenta}]"
    },
    "break",
    { "type": "colors", "symbol": "circle", "paddingLeft": 1 }
  ]
}
