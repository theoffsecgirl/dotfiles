#!/usr/bin/env bash
# gen-claude-md — genera el CLAUDE.md por-target de un programa de bug bounty
# a partir del scope YA resuelto en in/. No versiona credenciales.
# Uso: gen-claude-md <programa>
set -euo pipefail

prog="${1:-}"
if [[ -z "$prog" ]]; then
  echo "uso: gen-claude-md <programa>" >&2
  exit 2
fi

: "${HUNTING_HOME:?HUNTING_HOME no está exportado}"
tdir="$HUNTING_HOME/targets/$prog"
indir="$tdir/in"

if [[ ! -d "$tdir" ]]; then
  echo "[!] no existe $tdir — ¿has corrido program-init $prog?" >&2
  exit 1
fi

# guard-rail: sin scope-web no se genera contexto (lección de Vienna: scope vacío
# = Claude Code no puede confirmar scope y empieza a tocar hosts a ciegas)
if [[ ! -s "$indir/scope-web.txt" ]]; then
  echo "[!] $indir/scope-web.txt está vacío." >&2
  echo "    Resuelve el scope (scope-program $prog) antes de generar el contexto." >&2
  exit 1
fi

# helper: vuelca un fichero de in/ si existe y tiene contenido; si no, aviso
dump() {
  local f="$indir/$1"
  if [[ -s "$f" ]]; then
    cat "$f"
  else
    echo "(vacío — revisar $f)"
  fi
}

creds_env="$HUNTING_HOME/.creds/$prog.env"
if [[ -f "$creds_env" ]]; then
  creds_note="Cuentas de test cargadas como variables de entorno desde \`.creds/$prog.env\` (fuera de git). Úsalas para cross-account / IDOR / aislamiento entre tenants. NO las escribas en ningún fichero ni en notes."
else
  creds_note="No hay cuentas de test para este programa todavía (\`.creds/$prog.env\` no existe). Si necesitas una segunda cuenta, PARA y dime cómo crearla dentro de las reglas del programa."
fi

out="$tdir/CLAUDE.md"
cat > "$out" <<EOF
# CLAUDE.md — target: $prog

> Generado por \`gen-claude-md\`. Mi CLAUDE.md global (reglas duras, idioma, formato,
> stack, prioridades de vuln) aplica igual. Esto SOLO añade el contexto de este
> programa. No dupliques aquí lo que ya vive en el global.

## Programa

$(dump program.md)

## Scope in (web)

\`\`\`
$(dump scope-web.txt)
\`\`\`

## Roots

\`\`\`
$(dump roots.txt)
\`\`\`

## Out of scope

\`\`\`
$(dump out-of-scope.txt)
\`\`\`

## Brief

$(dump brief.txt)

## Cuentas

$creds_note

## Mandato para este target

Actúa como bug hunter sobre este programa siguiendo mi método:
explorar → entender → hipótesis → validar manual → demostrar impacto → documentar.

- Antes de tocar cualquier host, pásalo por el scope-gate. Si no está en el scope de
  arriba, no lo toques y dímelo.
- Prioriza según mi global: access control, IDOR, API, business logic, auth. NO
  priorices SQLi/RCE/XXE salvo evidencia clara.
- Usa mis skills (\`recon\`, \`idor-hunt\`, \`js-recon\`, \`report\`) en lugar de reinventar
  el paso a paso.
- Si ya hay outputs en \`http/\`, \`js/\`, \`fuzz/\`, analízalos antes de relanzar nada.
- Ningún finding es real sin impacto reproducible: pásalo por el finding-validator.
- PARA antes de cualquier acción irreversible (enviar, confirmar, pagar, publicar,
  borrar): esas las hago yo a mano.
- Mantén \`notes/summary.md\` actualizado. Antes de repetir una prueba, consúltalo.
EOF

echo "[+] escrito $out"
